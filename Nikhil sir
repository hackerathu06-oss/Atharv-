let list1 = ["Apple", "Banana", "Grapes"];
let list2 = ["Carrot", "Potato", "Tomato"];
let list3 = ["Pen", "Book", "Notebook"];

let userSelection = 2;

let merged;

switch (userSelection) {
  case 1:
    merged = list1.concat(list2);
    console.log("Merged list1 and list2:", merged);
    break;
  case 2:
    merged = list1.concat(list3);
    console.log("Merged list1 and list3:", merged);
